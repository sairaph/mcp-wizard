// Package mcpserver provides the MCP server setup and tool registration.
package mcpserver

import (
	"context"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// Server wraps the MCP server and domain logic.
type Server struct {
	mcpServer *mcp.Server
}

// New creates a new MCP server with the given version.
func New(version string) *Server {
	srv := &Server{
		mcpServer: mcp.NewServer(mcp.ServerInfo{
			Name:    "${ServerName}",
			Version: version,
		}),
	}

	// Register your tools here.
	// Example:
	// registerGreet(srv.mcpServer, srv)

	return srv
}

// Run starts the server and blocks until it exits.
func (s *Server) Run(ctx context.Context) error {
	// By default, run as stdio server.
	// Replace with SSE or other transport as needed.
	return s.mcpServer.ServeStdio(ctx)
}

