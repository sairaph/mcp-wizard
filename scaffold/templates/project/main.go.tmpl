// --- App ---

func runApp(ctx context.Context) int {
	screens := []app.Screen{
		menu.New("${ServerName}", buildMenu),
	}
	return app.Run(ctx, screens, app.Options{
		Title:   "${ServerName}",
		Version: version,
	})
}

func buildMenu() []menu.Item {
	return []menu.Item{
		{Label: "Browse", Action: "browse"},
		{Label: "Search", Action: "search"},
		{Label: "Settings", Action: "settings"},
		{Label: "Configure AI clients", Action: "configure"},
		{Label: "Quit", Action: "quit"},
	}
}

// --- MCP Server ---

func runMCPServer(ctx context.Context) int {
	transport := os.Getenv("TRANSPORT")
	if transport == "" {
		transport = "stdio"
	}
	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = "127.0.0.1:8080"
	}

	srv := mcpserver.New(mcpserver.Config{
		Version:   version,
		Transport: transport,
		HTTPAddr:  addr,
	})
	if err := srv.Run(ctx); err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	return 0
}
