var version = "dev"

var oneShotCommands = command.New()

func init() {
	// Example: oneShotCommands.Register(command.Handler{
	//     Name: "list-items",
	//     Description: "List all items",
	//     Run: func(ctx context.Context, args []string) int {
	//         return 0
	//     },
	// })
}

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	cmd, err := cli.Parse(os.Args[1:])
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
		os.Exit(2)
	}

	switch cmd.Name {
	case "mcp", "server", "serve":
		os.Exit(runMCPServer(ctx))
	case "install", "configure":
		os.Exit(runInstall(ctx, cmd))
	case "uninstall":
		os.Exit(runUninstall(ctx, cmd))
	case "add":
		os.Exit(runAdd(ctx, cmd))
	case "login":
		os.Exit(runLogin(ctx, cmd))
	case "doctor":
		os.Exit(runDoctor(ctx))
	case "update":
		os.Exit(runUpdate(ctx, cmd))
	case "help":
		cli.Usage(os.Stdout, []cli.Spec{
			{Name: "mcp", Description: "Run the MCP server (default)"},
			{Name: "install", Description: "Install and configure AI client integration"},
			{Name: "uninstall", Description: "Remove AI client integration"},
			{Name: "add", Description: "Add server to this project's AI client configs"},
			{Name: "login", Description: "Sign in to ${ServerName}"},
			{Name: "doctor", Description: "Diagnose installation"},
			{Name: "update", Description: "Update to the latest version"},
		})
	case "version":
		fmt.Println(version)
	default:
		// One-shot commands registered via command.Registry.
		if ok, code := oneShotCommands.Dispatch(ctx, cmd.Name, cmd.Args); ok {
			os.Exit(code)
		}
		// Bare invocation: app or MCP server.
		if tui.IsInteractive() {
			os.Exit(runApp(ctx))
		}
		fmt.Fprintf(os.Stderr, "Unknown command: %s. Running MCP server.\n", cmd.Name)
		os.Exit(runMCPServer(ctx))
	}
}

// --- App state shared across install wizard steps ---

type AppState struct {
	flow.BaseState
	Harness installer.HarnessState
	Login   installer.LoginState
}

// --- Install ---

func runInstall(ctx context.Context, cmd cli.Command) int {
	exec, err := harness.ResolveExecutable()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	detector, err := harness.New(harness.ServerSpec{
		Name:    "${ServerName}",
		Command: exec,
		Args:    []string{"mcp"},
	})
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	credStore := secret.NewFileStore(domain.CredentialPath())
	state := &AppState{}

	steps := []flow.Step[AppState]{
		installer.HarnessStep(ctx, detector,
			func(s *AppState) *installer.HarnessState { return &s.Harness },
			installer.HarnessStepOptions{AllDetected: true},
		),
		installer.LoginStep(ctx, domain.LoginConfig(credStore),
			func(s *AppState) *installer.LoginState { return &s.Login },
		),
	}

	if tui.IsInteractive() {
		return tui.Run(ctx, flow.New(steps, state), tui.Options{Title: "${ServerName} setup"})
	}

	return runUnattended(ctx, detector, credStore, cmd)
}

func runUnattended(ctx context.Context, detector *harness.Detector, credStore secret.Store, cmd cli.Command) int {
	// Detect harnesses and register with selected clients.
	harnesses := detector.Detect(ctx)
	var ids []harness.ID
	for _, h := range harnesses {
		if cmd.All || (h.Selectable() && !h.Configured) {
			ids = append(ids, h.ID)
		}
	}
	if len(ids) == 0 {
		installer.PrintNoClients(os.Stdout, "${ServerName}", false)
		return 0
	}
	results := detector.Apply(ctx, ids, harness.Present, harness.ConflictReplace)
	installer.PrintResults(os.Stdout, results, true, cmd.DryRun)
	return 0
}

// --- Add (project-scoped) ---

func runAdd(ctx context.Context, cmd cli.Command) int {
	dir := cmd.Dir
	if dir == "" {
		cwd, err := os.Getwd()
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		dir = cwd
	}

	exec, err := harness.ResolveExecutable()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	detector, err := harness.New(harness.ServerSpec{
		Name:    "${ServerName}",
		Command: exec,
		Args:    []string{"mcp"},
	})
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}

	scope := harness.ProjectScopeDir(dir)
	credStore := secret.NewFileStore(domain.ProjectCredentialPath(dir))
	state := &AppState{}

	steps := []flow.Step[AppState]{
		installer.HarnessStep(ctx, detector,
			func(s *AppState) *installer.HarnessState { return &s.Harness },
			installer.HarnessStepOptions{AllDetected: true, Scope: scope},
		),
		installer.LoginStep(ctx, domain.ProjectLoginConfig(credStore, dir),
			func(s *AppState) *installer.LoginState { return &s.Login },
		),
	}

	if tui.IsInteractive() {
		return tui.Run(ctx, flow.New(steps, state), tui.Options{Title: "${ServerName} project setup"})
	}

	harnesses := detector.DetectIn(ctx, scope)
	var ids []harness.ID
	for _, h := range harnesses {
		if cmd.All || (h.Selectable() && !h.Configured) {
			ids = append(ids, h.ID)
		}
	}
	if len(ids) == 0 {
		installer.PrintNoClients(os.Stdout, "${ServerName}", false)
		return 0
	}
	if cmd.DryRun {
		changes, _ := detector.PlanResultsIn(ctx, scope, ids, harness.Present, harness.ConflictReplace)
		// Print planned changes without writing
		for _, c := range changes {
			fmt.Printf("  %-22s would %s\n", c.Name, c.Action)
		}
	} else {
		results := detector.ApplyIn(ctx, scope, ids, harness.Present, harness.ConflictReplace)
		installer.PrintResultsWithScope(os.Stdout, results, scope, true, cmd.DryRun)
	}
	return 0
}

// --- Uninstall ---

func runUninstall(ctx context.Context, cmd cli.Command) int {
	exec, err := harness.ResolveExecutable()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	detector, err := harness.New(harness.ServerSpec{Name: "${ServerName}", Command: exec, Args: []string{"mcp"}})
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	harnesses := detector.Detect(ctx)
	var ids []harness.ID
	for _, h := range harnesses {
		if h.Configured {
			ids = append(ids, h.ID)
		}
	}
	if len(ids) == 0 {
		fmt.Println("  No clients are configured.")
		return 0
	}
	results := detector.Apply(ctx, ids, harness.Absent, harness.ConflictError)
	installer.PrintResults(os.Stdout, results, false, cmd.DryRun)
	return 0
}

// --- Login ---

func runLogin(ctx context.Context, cmd cli.Command) int {
	if !tui.IsInteractive() {
		fmt.Fprintln(os.Stderr, "login requires an interactive terminal")
		return 1
	}
	credStore := secret.NewFileStore(domain.CredentialPath())
	state := &AppState{}
	step := installer.LoginStep(ctx, domain.LoginConfig(credStore),
		func(s *AppState) *installer.LoginState { return &s.Login },
	)

	f := flow.New([]flow.Step[AppState]{step}, state)
	return tui.Run(ctx, f, tui.Options{Title: "${ServerName} login"})
}

